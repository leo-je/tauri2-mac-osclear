{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "purge", "cmd": "purge" },
        { "name": "vm_stat", "cmd": "vm_stat" },
        { "name": "df", "cmd": "df" },
        { "name": "du", "cmd": "du" },
        { "name": "ls", "cmd": "ls" },
        { "name": "rm", "cmd": "rm" },
        { "name": "find", "cmd": "find" },
        { "name": "osascript", "cmd": "osascript" }
      ]
    }
  ]
}
